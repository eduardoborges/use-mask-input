{
  "name": "use-mask-input",
  "version": "3.14.2",
  "private": false,
  "description": "Input masks for React and Vue 3. Works with React Hook Form, TanStack Form, vee-validate, and Ant Design.",
  "license": "MIT",
  "homepage": "https://use-mask-input.eduardoborges.dev",
  "author": "Eduardo Borges<euduardoborges@gmail.com>",
  "type": "module",
  "repository": {
    "url": "https://github.com/eduardoborges/use-mask-input"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "source": "./src/index.tsx",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./antd": {
      "import": {
        "types": "./dist/antd.d.mts",
        "default": "./dist/antd.mjs"
      },
      "require": {
        "types": "./dist/antd.d.cts",
        "default": "./dist/antd.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.mts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    }
  },
  "engines": {
    "node": ">=16",
    "npm": ">=7"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint ./src",
    "test": "vitest --project=unit --dir ./src --run --coverage",
    "test:browser": "vitest --project=browser --run",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postbuild": "node scripts/assert-entry-isolation.mjs && cp ../../README.md README.md"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!dist/*-stats.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "antd": ">=5",
    "react": ">=17",
    "react-dom": ">=17",
    "vee-validate": ">=4",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vee-validate": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "^2.0.1",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/inputmask": "5.0.7",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/server-renderer": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "antd": "^6.6.5",
    "inputmask": "5.0.10-beta.61",
    "jsdom": "^30.1.2",
    "oxlint": "1.77.0",
    "playwright": "^1.64.0",
    "react-hook-form": "7.89.0",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vee-validate": "^4.15.1",
    "vitest": "4.1.11",
    "vue": "^3.5.43"
  },
  "keywords": [
    "react",
    "vue",
    "react-hook-form",
    "tanstack-form",
    "vee-validate",
    "antd",
    "input-mask",
    "input-masking",
    "vue-mask",
    "mask"
  ]
}
